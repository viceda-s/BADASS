root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2

[*.md]
# Trailing whitespace is a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# FRR / Quagga configuration files. vtysh writes them back with a single-space
# indent, so matching that keeps diffs readable after a `write memory`.
[*.conf]
indent_size = 1
